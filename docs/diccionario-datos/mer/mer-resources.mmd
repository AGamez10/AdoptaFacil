erDiagram
  resource_deliveries {
    uuid id PK
    uuid organization_id FK
    uuid offer_id FK,UK
    uuid need_id
    text method
    timestamp scheduled_at
    text status
    timestamp completed_at
    timestamp created_at
    timestamp updated_at
  }
  resource_delivery_evidences {
    uuid id PK
    uuid organization_id FK
    uuid delivery_id FK
    text caption
    text storage_ref
    integer order
    timestamp deleted_at
    timestamp created_at
    timestamp updated_at
  }
  resource_fulfillment_applications {
    uuid id PK
    uuid organization_id FK
    uuid delivery_id FK,UK
    uuid need_id
    integer quantity_applied
    timestamp created_at
  }
  resource_needs {
    uuid id PK
    uuid organization_id FK
    text title
    text description
    text category
    integer quantity_needed
    text unit
    integer quantity_fulfilled
    text status
    timestamp created_at
    timestamp updated_at
  }
  resource_offer_proofs {
    uuid id PK
    uuid organization_id FK
    uuid offer_id FK
    uuid uploaded_by_user_id
    text filename
    text content_type
    integer size_bytes
    text storage_ref
    timestamp created_at
  }
  resource_offers {
    uuid id PK
    uuid organization_id FK
    uuid need_id FK
    uuid donor_user_id
    integer quantity_offered
    text message
    text status
    timestamp created_at
    timestamp updated_at
    text proof_status
    uuid proof_validated_by_user_id
    timestamp proof_validated_at
    text proof_validation_reason
  }
  resource_open_offers {
    uuid id PK
    uuid organization_id FK
    uuid donor_user_id
    text title
    text description
    text category
    integer quantity
    text unit
    text department
    text city
    text status
    uuid claimed_by_organization_id
    uuid claimed_need_id
    uuid claimed_offer_id
    timestamp claimed_at
    timestamp expires_at
    timestamp created_at
    timestamp updated_at
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
  resource_offers ||--o| resource_deliveries : "offer_id"
  organizations ||--o{ resource_deliveries : "organization_id"
  resource_deliveries ||--o{ resource_delivery_evidences : "delivery_id"
  organizations ||--o{ resource_delivery_evidences : "organization_id"
  resource_deliveries ||--o| resource_fulfillment_applications : "delivery_id"
  organizations ||--o{ resource_fulfillment_applications : "organization_id"
  organizations ||--o{ resource_needs : "organization_id"
  resource_offers ||--o{ resource_offer_proofs : "offer_id"
  organizations ||--o{ resource_offer_proofs : "organization_id"
  resource_needs ||--o{ resource_offers : "need_id"
  organizations ||--o{ resource_offers : "organization_id"
  organizations ||--o{ resource_open_offers : "organization_id"
  users ||..o{ resource_offer_proofs : "uploaded_by_user_id (lógica)"
  users ||..o{ resource_offers : "donor_user_id (lógica)"
  users |o..o{ resource_offers : "proof_validated_by_user_id (lógica)"
  users ||..o{ resource_open_offers : "donor_user_id (lógica)"
  organizations |o..o{ resource_open_offers : "claimed_by_organization_id (lógica)"
