  organizations ||--o{ org_reports : "organization_id"
  organizations ||--o{ org_signature_requests : "organization_id"
  org_reports ||--o{ org_signature_requests : "report_id"
  users ||--o{ org_signature_requests : "signer_user_id"
  users ||--o{ org_signer_designations : "designated_by_user_id"
  organizations ||--o{ org_signer_designations : "organization_id"
  users |o--o{ org_signer_designations : "revoked_by_user_id"
