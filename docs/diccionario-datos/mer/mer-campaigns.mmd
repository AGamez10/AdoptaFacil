erDiagram
  campaign_evidences {
    uuid id PK
    uuid organization_id FK
    uuid campaign_id FK
    text type
    text concept
    integer amount
    timestamp spent_at
    text storage_ref
    integer order
    timestamp created_at
  }
  campaign_funding_applications {
    uuid id PK
    uuid organization_id FK
    uuid campaign_id FK
    text collection_id UK
    integer net
    timestamp created_at
    timestamp reversed_at
  }
  campaigns {
    uuid id PK
    uuid organization_id FK
    text title
    text description
    text category
    integer goal_amount
    integer raised_amount
    timestamp deadline
    text status
    timestamp created_at
    timestamp updated_at
  }
  organizations {
    uuid id PK
  }
  campaigns ||--o{ campaign_evidences : "campaign_id"
  organizations ||--o{ campaign_evidences : "organization_id"
  campaigns ||--o{ campaign_funding_applications : "campaign_id"
  organizations ||--o{ campaign_funding_applications : "organization_id"
  organizations ||--o{ campaigns : "organization_id"
