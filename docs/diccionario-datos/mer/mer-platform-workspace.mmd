erDiagram
  auth_mfa_factors {
    uuid id PK
    uuid user_id FK,UK
    text secret_ciphertext
    timestamp confirmed_at
    bigint last_used_step
    timestamp created_at
    timestamp updated_at
  }
  platform_sensitive_action_decisions {
    uuid id PK
    uuid organization_id FK
    uuid action_id FK,UK
    text decision
    uuid decided_by_user_id
    text note
    jsonb result
    timestamp created_at
  }
  platform_sensitive_actions {
    uuid id PK
    uuid organization_id FK
    text type
    jsonb payload
    text reason
    uuid requested_by_user_id
    timestamp requested_at
    timestamp expires_at
  }
  platform_workspace_ticket_events {
    uuid id PK
    uuid organization_id FK
    uuid ticket_id FK
    integer seq
    text type
    text status
    uuid assignee_user_id
    uuid actor_user_id
    text note
    timestamp created_at
  }
  platform_workspace_tickets {
    uuid id PK
    uuid organization_id FK
    uuid subject_organization_id
    text kind
    uuid created_by_user_id
    timestamp created_at
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
  users ||--o| auth_mfa_factors : "user_id"
  platform_sensitive_actions ||--o| platform_sensitive_action_decisions : "action_id, organization_id"
  organizations ||--o{ platform_sensitive_action_decisions : "organization_id"
  organizations ||--o{ platform_sensitive_actions : "organization_id"
  organizations ||--o{ platform_workspace_ticket_events : "organization_id"
  platform_workspace_tickets ||--o{ platform_workspace_ticket_events : "ticket_id, organization_id"
  organizations ||--o{ platform_workspace_tickets : "organization_id"
  users ||..o{ platform_sensitive_action_decisions : "decided_by_user_id (lógica)"
  users ||..o{ platform_sensitive_actions : "requested_by_user_id (lógica)"
  users |o..o{ platform_workspace_ticket_events : "assignee_user_id (lógica)"
  users |o..o{ platform_workspace_ticket_events : "actor_user_id (lógica)"
  organizations ||..o{ platform_workspace_tickets : "subject_organization_id (lógica)"
  users |o..o{ platform_workspace_tickets : "created_by_user_id (lógica)"
