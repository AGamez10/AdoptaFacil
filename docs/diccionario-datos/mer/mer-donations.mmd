erDiagram
  donation_access_links {
    uuid id PK
    uuid donation_id FK
    text token_hash UK
    timestamp expires_at
    timestamp created_at
  }
  donation_certificates {
    uuid id PK
    uuid organization_id
    uuid donation_id FK,UK
    text code UK
    jsonb payload
    text content_hash
    timestamp issued_at
    timestamp created_at
  }
  donation_receipts {
    uuid id PK
    uuid organization_id FK
    uuid donation_id FK,UK
    text dedup_key UK
    jsonb donor
    integer intended_amount
    jsonb breakdown
    timestamp issued_at
    timestamp created_at
  }
  donation_reversals {
    uuid id PK
    uuid organization_id
    uuid donation_id FK,UK
    text reason
    text dedup_key
    timestamp reversed_at
  }
  donations {
    uuid id PK
    uuid organization_id FK
    uuid donor_user_id
    text concept_kind
    uuid concept_id
    integer intended_amount
    integer amount_charged
    text currency
    jsonb breakdown
    text collection_id UK
    text idempotency_key
    text status
    jsonb payer
    timestamp created_at
    timestamp updated_at
    boolean anonymous
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
  donations ||--o{ donation_access_links : "donation_id"
  donations ||--o| donation_certificates : "donation_id"
  donations ||--o| donation_receipts : "donation_id"
  organizations ||--o{ donation_receipts : "organization_id"
  donations ||--o| donation_reversals : "donation_id"
  organizations ||--o{ donations : "organization_id"
  organizations ||..o{ donation_certificates : "organization_id (lógica)"
  organizations ||..o{ donation_reversals : "organization_id (lógica)"
  users |o..o{ donations : "donor_user_id (lógica)"
