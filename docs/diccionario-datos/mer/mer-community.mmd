    text status
    text moderation_reason
    uuid moderated_by_user_id
    timestamp moderated_at
    boolean is_partner
    timestamp partner_since
    timestamp created_at
    timestamp updated_at
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
