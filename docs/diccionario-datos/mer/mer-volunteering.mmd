erDiagram
  service_hours {
    uuid id PK
    uuid organization_id FK
    uuid enrollment_id FK
    uuid volunteer_user_id FK
    timestamp date
    double_precision hours
    text description
    text status
    text rejection_reason
    uuid decided_by_user_id
    timestamp decided_at
    timestamp created_at
  }
  service_hours_photos {
    uuid id PK
    uuid organization_id
    uuid service_hours_id FK
    uuid volunteer_user_id
    text storage_ref
    text content_type
    integer size_bytes
    text sha256
    timestamp created_at
  }
  volunteer_certificates {
    uuid id PK
    uuid organization_id FK
    uuid enrollment_id FK,UK
    uuid volunteer_user_id FK
    text volunteer_name
    text organization_name
    text opportunity_title
    double_precision total_approved_hours
    timestamp period_start
    timestamp period_end
    boolean applies_to_student_service
    uuid issued_by_user_id
    timestamp issued_at
    text guardian_name
    text guardian_document
    text school_name
    text school_agreement_code
    jsonb bitacora
    uuid signer_legal_representative_id
    text signer_signature_hash
    text signer_full_name
    text signer_position
    boolean signer_is_legal_representative
  }
  volunteer_enrollments {
    uuid id PK
    uuid organization_id FK
    uuid opportunity_id FK
    uuid volunteer_user_id FK
    text volunteer_name
    text volunteer_email
    boolean applies_to_student_service
    text status
    text rejection_reason
    uuid decided_by_user_id
    timestamp decided_at
    timestamp created_at
    boolean is_minor
    text guardian_name
    text guardian_document
    text school_name
    text school_agreement_code
  }
  volunteer_opportunities {
    uuid id PK
    uuid organization_id FK
    text title
    text description
    text category
    timestamp start_date
    timestamp end_date
    integer capacity
    text location
    text requirements
    boolean applies_to_student_service
    text status
    timestamp created_at
    timestamp updated_at
    date_array session_dates
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
  volunteer_enrollments ||--o{ service_hours : "enrollment_id"
  organizations ||--o{ service_hours : "organization_id"
  users ||--o{ service_hours : "volunteer_user_id"
  service_hours ||--o{ service_hours_photos : "service_hours_id"
  volunteer_enrollments ||--o| volunteer_certificates : "enrollment_id"
  organizations ||--o{ volunteer_certificates : "organization_id"
  users ||--o{ volunteer_certificates : "volunteer_user_id"
  volunteer_opportunities ||--o{ volunteer_enrollments : "opportunity_id"
  organizations ||--o{ volunteer_enrollments : "organization_id"
  users ||--o{ volunteer_enrollments : "volunteer_user_id"
  organizations ||--o{ volunteer_opportunities : "organization_id"
  users |o..o{ service_hours : "decided_by_user_id (lógica)"
  organizations ||..o{ service_hours_photos : "organization_id (lógica)"
  users ||..o{ service_hours_photos : "volunteer_user_id (lógica)"
  users ||..o{ volunteer_certificates : "issued_by_user_id (lógica)"
  users |o..o{ volunteer_enrollments : "decided_by_user_id (lógica)"
