erDiagram
  product_images {
    uuid id PK
    uuid organization_id FK
    uuid product_id FK
    text storage_ref
    integer order
    timestamp created_at
  }
  products {
    uuid id PK
    uuid organization_id FK
    text name
    text description
    text category
    integer price
    integer stock
    boolean is_active
    timestamp created_at
    timestamp updated_at
  }
  organizations {
    uuid id PK
  }
  organizations ||--o{ product_images : "organization_id"
  products ||--o{ product_images : "product_id"
  organizations ||--o{ products : "organization_id"
