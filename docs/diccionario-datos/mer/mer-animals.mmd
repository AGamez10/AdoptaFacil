  clinical_event_attachments {
    uuid id PK
    uuid organization_id FK
    uuid clinical_event_id FK
    text storage_ref
    integer order
    timestamp created_at
  }
  clinical_events {
    uuid id PK
    uuid event_id
    uuid organization_id FK
    uuid animal_id FK
    text type
    timestamp occurred_at
    timestamp next_due_date
    jsonb details
    integer version
    uuid author_user_id
    timestamp created_at
  }
  clinical_reminders {
    uuid id PK
    uuid organization_id FK
    uuid animal_id FK
    uuid clinical_event_id
    text reminder_type
    timestamp due_date
    text status
    text channel
    timestamp created_at
    timestamp sent_at
    timestamp resolved_at
    uuid resolved_by_user_id
  }
  organizations {
    uuid id PK
  }
  sponsorship_plans {
    uuid id PK
    uuid organization_id FK
    uuid animal_id FK
  }
  sponsorships {
    uuid id PK
    uuid organization_id FK
    uuid plan_id FK
    uuid animal_id FK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
