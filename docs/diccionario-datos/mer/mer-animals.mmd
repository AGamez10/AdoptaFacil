    timestamp created_at
  }
  animal_photos {
    uuid id PK
    uuid organization_id FK
    uuid animal_id FK
    text storage_ref
    integer order
    timestamp created_at
  }
  animals {
    uuid id PK
    uuid organization_id FK
    text name
    text species
    text sex
    text size
    text status
    uuid breed_id FK
    text custom_breed
    timestamp birth_date
    integer approximate_age_months
    text description
    boolean is_active
    timestamp created_at
    timestamp updated_at
