erDiagram
  mercadopago_payments {
    uuid id PK
    uuid organization_id FK
    text mp_payment_id
    text collector_id
    text external_reference
    uuid donation_id
    text status
    text status_detail
    text currency
    numeric transaction_amount
    numeric net_received_amount
    numeric transaction_amount_refunded
    jsonb fee_details
    jsonb refunds
    text payment_type_id
    text payment_method_id
    timestamp date_approved
    timestamp money_release_date
    timestamp first_seen_at
    timestamp updated_at
  }
  organization_mercadopago_connections {
    uuid id PK
    uuid organization_id FK,UK
    text mp_user_id UK
    text access_token_enc
    text refresh_token_enc
    text public_key
    boolean live_mode
    text scope
    text status
    timestamp expires_at
    timestamp last_refreshed_at
    text last_error
    uuid connected_by_user_id
    timestamp connected_at
    timestamp updated_at
  }
  donations {
    uuid id PK
    uuid organization_id FK
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
  organizations ||--o{ mercadopago_payments : "organization_id"
  organizations ||--o| organization_mercadopago_connections : "organization_id"
  donations |o..o{ mercadopago_payments : "donation_id (lógica)"
  users |o..o{ organization_mercadopago_connections : "connected_by_user_id (lógica)"
