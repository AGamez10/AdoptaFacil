erDiagram
  sponsorship_payment_attempts {
    uuid id PK
    uuid organization_id FK
    uuid sponsorship_payment_id FK
    integer attempt_number
    text collection_id
    text payment_link_url
    text idempotency_key UK
    timestamp expires_at
    text result
    timestamp created_at
  }
  sponsorship_payments {
    uuid id PK
    uuid organization_id FK
    uuid sponsorship_id FK
    text period
    text status
    timestamp period_started_at
    integer attempt_count
    integer reminders_sent
    timestamp paid_at
    timestamp failed_at
    timestamp created_at
    timestamp updated_at
  }
  sponsorship_plans {
    uuid id PK
    uuid organization_id FK
    uuid animal_id FK
    text name
    integer amount
    text periodicity
    boolean is_active
    timestamp created_at
    timestamp updated_at
  }
  sponsorship_status_history {
    uuid id PK
    uuid organization_id FK
    uuid sponsorship_id FK
    text from_status
    text to_status
    uuid actor_user_id
    text reason
    timestamp created_at
  }
  sponsorships {
    uuid id PK
    uuid organization_id FK
    uuid plan_id FK
    uuid animal_id FK
    uuid sponsor_user_id
    text status
    timestamp started_at
    timestamp suspended_at
    timestamp cancelled_at
    timestamp created_at
    timestamp updated_at
    text sponsor_name
    timestamp next_billing_at
  }
  animals {
    uuid id PK
    uuid organization_id FK
    uuid breed_id FK
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }
  organizations ||--o{ sponsorship_payment_attempts : "organization_id"
