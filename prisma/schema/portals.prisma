// Module: portals · Owner: @fabian
//
// M14 — personalización por tokens (T-027). Cada organización guarda su tema de
// marca (subconjunto SEGURO de tokens ya validados). Tenant-scoped business data:
// lleva organization_id y está protegida por Row-Level Security (RLS ENABLE+FORCE
// + tenant_isolation), igual que el patrón de _rls_probe (org.prisma). El portal
// PÚBLICO no lee esta tabla directamente: pasa por la función SECURITY DEFINER
// `organization_portal_theme(slug)`, que devuelve sólo los tokens (públicos por
// naturaleza) sin evadir RLS.
//
// NOTA DE FRONTERA (M14→M01): NO se declara aquí la relación Prisma con
// `Organization` (vive en org.prisma, propiedad de @sebastian) para no editar su
// archivo. La integridad referencial (FK + ON DELETE CASCADE) se añade en el SQL
// de la migración T-027, del mismo modo que Prisma no modela la RLS y ésta se
// añade a mano en la migración.

/// Tema de marca por organización (1:1). `tokens` guarda SÓLO el subconjunto
/// seguro (colores en canales HSL + `radius`), ya validado en la API antes de
/// escribir. Un tema vacío ⇒ el portal usa el tema por defecto del design system.
model PortalTheme {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @unique @map("organization_id") @db.Uuid
  /// PortalTheme (contrato): Partial<Record<PortalThemeToken, string>>.
  tokens            Json     @default("{}")
  /// "left" | "center" | "right" (S2-PORTAL). Dónde se posiciona el logo sobre
  /// el hero del portal público. Validado en la API (no CSS libre), igual que
  /// `tokens` — esto NO vive dentro de `tokens` porque no es un valor de color/
  /// longitud CSS, es una posición estructural distinta en naturaleza.
  logoPosition      String?  @default("left") @map("logo_position")
  /// "left" | "right" (S2-PORTAL). De qué lado va el sidebar de redes/contacto
  /// respecto al catálogo de animales.
  socialNavPosition String?  @default("right") @map("social_nav_position")
  /// Planes (`portalRemoveSeal`): la organización pidió ocultar el sello "Hecho
  /// con AdoptaFácil". Solo aplica si su plan vigente incluye la capacidad.
  hideSeal          Boolean  @default(false) @map("hide_seal")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("portal_themes")
}

/// QR fijo de la organización (una etiqueta impresa que nunca cambia). El QR
/// codifica `/q/<code>`; `code` se crea una vez y un trigger impide cambiarlo.
/// Lo único editable es el DESTINO, guardado como tipo + id (nunca una URL, así
/// no hay redirección abierta): `profile` (su portal público), `donate`
/// (donar a la org), `campaign` (una de
/// sus campañas activas) o `animal` (apadrinar uno de sus animales). La lectura
/// pública pasa por `resolve_organization_qr(code)` (SECURITY DEFINER), que
/// valida que el destino siga siendo de la org y publicable; si no, cae a donar.
model OrganizationQrLink {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  code            String   @unique
  /// "profile" | "donate" | "campaign" | "animal" (contrato QrTargetKind).
  targetKind      String   @default("donate") @map("target_kind")
  /// Campaña o animal de la misma org; null para "profile" y "donate".
  targetId        String?  @map("target_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("organization_qr_links")
}

/// Contador diario de escaneos del QR por destino. Solo un total: sin IP,
/// navegador ni ubicación (minimización, Ley 1581). Lo incrementa
/// `resolve_organization_qr`; la org lo lee bajo su RLS.
model OrganizationQrScanDay {
  organizationId String   @map("organization_id") @db.Uuid
  day            DateTime @db.Date
  targetKind     String   @map("target_kind")
  scans          Int      @default(0)

  @@id([organizationId, day, targetKind])
  @@index([organizationId])
  @@map("organization_qr_scan_days")
}
