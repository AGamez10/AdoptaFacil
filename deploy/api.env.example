# Variables OPCIONALES de la API (integraciones). Copia a deploy/api.env
# (ignorado por git) y deja SOLO las líneas que uses: la validación de la API
# rechaza una variable presente pero vacía (BLD-001).
#
# ⚠️ Drivers: en producción la API se niega a arrancar con `fake`/`log`
# (guarda de arranque seguro, R0-1). Los valores de abajo son los seguros por
# defecto: integraciones apagadas hasta tener credenciales reales.
AUTH_IDENTITY_DRIVER=disabled
PAYMENT_DRIVER=disabled
DIAN_DRIVER=disabled
SIGNATURE_DRIVER=disabled

# Correo transaccional (proveedor ⟦POR DEFINIR⟧). Obligatorio en producción:
# no existe un driver de correo apagado, así que hay que llenar las SMTP_*.
NOTIFICATION_DRIVER=smtp
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Identidad (Google Sign-In): cambia AUTH_IDENTITY_DRIVER a google y llena:
# GOOGLE_OAUTH_CLIENT_ID=

# Pagos: apagados (PAYMENT_DRIVER=disabled) hasta confirmación escrita del PSP
# y concepto del abogado (§4 D1–D7).
# ePayco (pasarela principal, docs/pagos/epayco.md): PAYMENT_DRIVER=epayco.
# Modo directo: cada organización conecta SUS llaves desde el panel; la API no
# necesita llaves de la plataforma. Usa primero el sandbox.
# EPAYCO_TEST=true
# EPAYCO_CONFIRMATION_URL=
# EPAYCO_RESPONSE_URL=
# Split agregador: APAGADO hasta aprobación escrita de ePayco + concepto legal.
# EPAYCO_COLLECTION_MODE=direct_to_org

# Planes y suscripciones: apagados (todas las organizaciones tienen Pro).
# Al encender PLAN_ENFORCEMENT=true, quien no tenga suscripción tiene Pro gratis
# durante 3 meses desde PLAN_LAUNCH_DATE (plantillas de pago incluidas); después
# vuelve a Gratis y su portal pasa a una plantilla gratuita.
# PLAN_ENFORCEMENT=true
# PLAN_LAUNCH_DATE=2026-11-01

# Almacenamiento en un bucket compatible con S3 (Cloudflare R2, Backblaze B2).
# Por defecto STORAGE_DRIVER=disk (disco del servidor). Para R2, descomenta estas
# líneas con tus valores reales en deploy/api.env (nunca en este archivo).
# Ver "Almacenamiento en Cloudflare R2" en docs/operacion/DESPLIEGUE_VPS.md.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=<nombre-del-bucket>
# S3_ACCESS_KEY_ID=<clave-de-acceso>
# S3_SECRET_ACCESS_KEY=<clave-secreta>
