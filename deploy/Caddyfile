# Caddy: TLS automático (Let's Encrypt), SPA y proxy inverso de la API.
# Variables (deploy/.env): APP_DOMAIN, ACME_EMAIL, PORTALS_TLS y las credenciales
# DNS del proveedor elegido (CLOUDFLARE_API_TOKEN o NAMECHEAP_*).
#
# Cada host sirve el SPA y, en /api/*, la API (se quita el prefijo /api antes de
# pasar a NestJS). El front se compila con VITE_API_URL=/api (relativa), así que
# cada host habla con la API en su propio origen: la cookie httpOnly de refresco
# y CORS nunca cruzan dominios, tampoco desde un portal en <org>.APP_DOMAIN.
#
# Portales por subdominio (*.APP_DOMAIN, F7): PORTALS_TLS elige el bloque.
#   off        sin comodín (por defecto)
#   cloudflare certificado comodín por DNS-01 en Cloudflare (producción)
#   namecheap  certificado comodín por DNS-01 en Namecheap (producción)
#   internal   comodín con la CA interna de Caddy (CI y pruebas locales)
# No se habilita on-demand TLS sin un endpoint `ask` que autorice solo dominios
# verificados: sin él, cualquiera podría hacernos emitir certificados.
{
	email {$ACME_EMAIL}
	# Cloudflare con proxy (nube naranja) delante: Caddy conserva el
	# X-Forwarded-For SOLO si la petición viene de una IP de Cloudflare, y la
	# API cuenta 2 saltos (TRUST_PROXY_HOPS) para ver la IP real del visitante.
	# Sin esto, todos los visitantes que entran por el mismo nodo de Cloudflare
	# compartirían un solo cupo del límite por IP. Cualquier otro origen no puede
	# falsear la cabecera: Caddy la reemplaza por la IP que ve.
	# Rangos de https://www.cloudflare.com/ips/ (revisar si Cloudflare los cambia).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	# Dominios propios de los portales (plan Pro, CUSTOM_DOMAINS=on): el
	# certificado de un dominio ajeno se emite la primera vez que alguien entra,
	# SOLO si la API responde 200 aquí (dominio verificado por DNS y plan
	# vigente). Sin esta pregunta cualquiera podría hacernos emitir
	# certificados. Ver docs/operacion/DOMINIO-PROPIO.md.
	on_demand_tls {
		ask http://api:3000/public/portal-domains/ask
	}
	# Logs de acceso en JSON por stdout (los recoge Docker con rotación).
	log {
		output stdout
		format json
	}
}

(app) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}

	# Subidas: el tope general de la API es STORAGE_MAX_FILE_MB (15 MB). Los
	# videos (comunidad, hasta 80 MB, y portada del portal, hasta 80 MB) se
	# comprimen en el servidor, así que el original puede pesar más: el techo
	# es el límite duro del multipart de la API (100 MB).
	request_body {
		max_size 100MB
	}

	handle_path /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
			health_uri /health
			health_interval 30s
		}
	}

	# Enlaces para compartir publicaciones de la comunidad (/p/<uuid>?s=<red>):
	# la API responde el HTML con Open Graph para WhatsApp, Facebook, X y
	# LinkedIn, y manda a la persona a la publicación con parámetros UTM.
	# /c/<uuid> es el formato viejo (enlaces ya compartidos). Solo un UUID va a
	# la API: /c/<código de 8> es el QR impreso en las bolsas de café y lo
	# atiende la web. No ampliar este patrón a /c/* (ver short-links.tsx).
	@share_link path_regexp ^/[pc]/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$
	handle @share_link {
		rewrite * /public/share{uri}
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Recursos con hash en el nombre: caché larga e inmutable.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv/web
		# SEO: /adoptar/perros sirve el HTML prerenderizado /adoptar/perros/index.html
		# (título, canónica, JSON-LD y contenido sin JavaScript). Antes `{path}` no
		# casaba con la carpeta y todo caía en la portada. Lo demás (rutas privadas,
		# 404, páginas creadas tras el build) recibe el cascarón app.html.
		try_files {path} {path}/index.html /app.html
		# Imágenes sin hash (public/): un día. El HTML (portada, páginas
		# prerenderizadas y app.html) se revalida siempre para que un build nuevo
		# llegue de inmediato. /assets/* ya trae su caché inmutable (arriba).
		@static path *.webp *.png *.jpg *.jpeg *.svg *.ico *.woff2 *.mp4
		header @static Cache-Control "public, max-age=86400"
		@document not path /assets/* *.webp *.png *.jpg *.jpeg *.svg *.ico *.woff2 *.mp4
		header @document Cache-Control "no-cache"
		# PWA: el service worker y el manifiesto se revisan en cada visita para que
		# una versión nueva llegue sin esperar a que caduque una caché.
		header /sw.js Cache-Control "no-cache"
		header /manifest.webmanifest Cache-Control "no-cache"
		# CSP de la web, APLICADA (auditoría run-4; antes solo reportaba). Va
		# solo en este bloque: las respuestas de /api/* (incluidos los archivos
		# subidos y la página puente de /p/<uuid>) conservan su propia CSP,
		# más estricta, que les pone la API. Cada violación se sigue reportando
		# a /api/public/security/csp-report. Orígenes permitidos, todos usados
		# hoy por la web: Google Identity (inicio de sesión), Google Fonts
		# (plantillas de portal), mapas de Google y OpenStreetMap (portal). Los
		# pagos no necesitan origen propio: la web manda a la persona a la
		# página de Mercado Pago (navegación, no iframe ni script). Revisada con
		# Playwright contra el build de producción (scripts/e2e/cobros-mercadopago).
		# Run-2 R-05: frame-src blob: (visor de PDF privados) y media-src blob:
		# https: (videos de la comunidad y del CDN).
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com/gsi/; frame-src blob: https://accounts.google.com https://maps.google.com https://www.google.com https://www.openstreetmap.org; media-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/public/security/csp-report"
		file_server
	}
}

# Con PORTALS_TLS=cloudflare|namecheap el certificado sale por DNS-01, que no
# depende de que Let's Encrypt llegue al VPS: necesario con la nube naranja y
# el origen cerrado a Cloudflare (docs/operacion/BLINDAJE-VPS.md).
{$APP_DOMAIN} {
	import edge-tls-{$PORTALS_TLS:off}.caddy
	import app
}

# www siempre redirige al dominio principal (necesita su registro DNS).
www.{$APP_DOMAIN} {
	import edge-tls-{$PORTALS_TLS:off}.caddy
	redir https://{$APP_DOMAIN}{uri} permanent
}

import portals-{$PORTALS_TLS:off}.caddy

# Dominios propios de las organizaciones Pro: CUSTOM_DOMAINS=on|off.
import custom-domains-{$CUSTOM_DOMAINS:off}.caddy
