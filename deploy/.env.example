# Variables de deploy/compose.yaml. Copia este archivo a deploy/.env (ignorado
# por git), rellena cada valor y protégelo:  chmod 600 deploy/.env
# Genera cada secreto con:  openssl rand -hex 24
# (SIGNATURE_ENCRYPTION_KEY: exactamente  openssl rand -hex 32)

# Etiqueta de la versión desplegada (p. ej. el SHA corto del commit). Nombra las
# imágenes para poder volver a la anterior (rollback).
RELEASE=

# Dominio público (sin https://) y correo para Let's Encrypt.
APP_DOMAIN=
ACME_EMAIL=

# PostgreSQL: owner de la base (migraciones). Nunca lo usa la API.
POSTGRES_USER=adoptafacil
POSTGRES_PASSWORD=
POSTGRES_DB=adoptafacil

# Contraseña del rol de runtime adoptafacil_app (sin BYPASSRLS): >= 24 caracteres
# alfanuméricos (openssl rand -hex 24). La aplica `migrate` en cada despliegue.
APP_DB_PASSWORD=

# Secretos de la API.
JWT_SECRET=
SIGNATURE_ENCRYPTION_KEY=

# Tope de subida en MB (Caddy acepta hasta 20 MB por petición).
STORAGE_MAX_FILE_MB=15

# Portales por subdominio (<org>.APP_DOMAIN). Ver docs/operacion/DESPLIEGUE_VPS.md.
#   off        sin portales por subdominio (siguen en /o/<slug>)
#   cloudflare certificado comodín por DNS-01 (DNS de la zona en Cloudflare)
#   namecheap  certificado comodín por DNS-01 (DNS de la zona en Namecheap)
#   internal   solo pruebas: CA interna de Caddy
PORTALS_TLS=off
# Con PORTALS_TLS=cloudflare: token de API con permiso Zone:DNS:Edit solo sobre
# la zona de APP_DOMAIN. Secreto: solo en este archivo del servidor.
CLOUDFLARE_API_TOKEN=
# Con PORTALS_TLS=namecheap: usuario y clave de la API de Namecheap, y la IPv4
# pública del VPS (la misma que se pone en la lista blanca de esa API).
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=

# Variables del frontend (se hornean en el bundle; nunca un secreto aquí).
# Con portales activos, el mismo valor que APP_DOMAIN (p. ej. adoptafacil.org).
VITE_PORTAL_BASE_DOMAIN=
VITE_GOOGLE_CLIENT_ID=
VITE_MERCADOPAGO_PUBLIC_KEY=
VITE_PAYMENT_PROVIDER=

# Copias de seguridad (deploy/scripts/backup.sh). Ver docs/operacion/BACKUPS.md.
# Destinatario age (clave pública) con el que se cifran los respaldos. La clave
# privada NO vive en el VPS.
BACKUP_AGE_RECIPIENT=
# Días de retención local.
BACKUP_RETENTION_DAYS=14
# Destino off-site para rclone (p. ej. "b2:adoptafacil-backups"); vacío = solo local.
# Recomendado: Backblaze B2 con clave limitada al bucket (docs/operacion/BACKUPS.md).
BACKUP_RCLONE_REMOTE=

# Alertas (deploy/scripts/monitor.sh y backup.sh). Ver docs/operacion/MONITOREO.md.
# URL que recibe un POST con el texto de la alerta (ntfy, Slack, Discord, Telegram…).
ALERT_WEBHOOK_URL=
# Ping "dead man's switch" del respaldo diario (p. ej. healthchecks.io); vacío = sin ping.
BACKUP_HEALTHCHECK_URL=
