# ==============================================================================
# deploy/api.env de PRODUCCIÓN (plantilla para salir). Explicación de cada línea
# y de dónde sale cada clave: docs/operacion/ENV-PRODUCCION.md
#
#   cp deploy/api.env.produccion.example deploy/api.env
#   nano deploy/api.env        # reemplaza cada <...> por el valor real
#   chmod 600 deploy/api.env
#   deploy/scripts/preflight.sh  # dice en español qué falta, sin mostrar secretos
#
# Reglas:
#  - Nunca un secreto real en este archivo del repositorio: solo en el servidor.
#  - Interruptores de la API: SOLO true o false ("on", "1" o "yes" no arrancan).
#    (CUSTOM_DOMAINS y PORTALS_TLS son de deploy/.env y ahí sí van con on/off).
#  - Una línea "CLAVE=" vacía no se acepta: si no usas algo, deja la línea con #.
#  - Los ejemplos usan adoptafacil.org: cámbialo si tu APP_DOMAIN es otro.
#  - Lo que el compose ya pone solo (base de datos, Redis, dominio, JWT, etc.)
#    NO va aquí: se arma desde deploy/.env.
# ==============================================================================

# --- Drivers (obligatorio) -----------------------------------------------------
# En producción la API no arranca con fake/log/stub.
AUTH_IDENTITY_DRIVER=disabled
DIAN_DRIVER=disabled
# Firma electrónica simple de la plataforma (contratos de adopción).
SIGNATURE_DRIVER=internal
NOTIFICATION_DRIVER=smtp

# --- Correo con Amazon SES (obligatorio) ---------------------------------------
# Paso a paso: docs/operacion/GUIA-PASO-A-PASO-PRODUCCION.md, punto 2.
# Credenciales SMTP de SES (NO son la clave de tu cuenta de AWS).
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=<SMTP user name de SES>
SMTP_PASS=<SMTP password de SES>
SMTP_FROM="AdoptaFácil" <no-reply@adoptafacil.org>
# Ritmo: "Maximum send rate" de SES menos 1 (sandbox = 1 por segundo).
EMAIL_QUEUE_RATE_MAX=1
EMAIL_QUEUE_RATE_DURATION_MS=1000

# --- Archivos en Cloudflare R2 (recomendado) ------------------------------------
# Sin estas líneas los archivos quedan en el disco del VPS (funciona, pero si el
# VPS se pierde se pierden las fotos). Guía: punto 5.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<nombre-del-bucket>
S3_ACCESS_KEY_ID=<Access Key ID de R2>
S3_SECRET_ACCESS_KEY=<Secret Access Key de R2>

# --- Donaciones con Mercado Pago (cada refugio cobra en SU cuenta) -------------
# docs/pagos/mercadopago-oauth.md y docs/pagos/ESTADO-MERCADOPAGO-PRODUCCION.md
PAYMENT_DRIVER=mercadopago
FEATURE_PAYMENTS=true
PAYMENTS_PRODUCTION_APPROVAL_REF=<fecha y referencia de tu aprobación escrita>
API_PUBLIC_BASE_URL=https://adoptafacil.org/api
# App "Checkout Pro (Orders)" → Credenciales de producción.
MERCADOPAGO_CLIENT_ID=<Client ID>
MERCADOPAGO_CLIENT_SECRET=<Client Secret>
# Clave secreta de Webhooks de la app Checkout Pro (Orders).
MERCADOPAGO_ORDERS_WEBHOOK_SECRET=<clave secreta de webhooks de Orders>

# --- Planes Crece/Pro y café: cuenta PROPIA de AdoptaFácil ---------------------
# App "Suscripciones" → Access token de PRODUCCIÓN y su clave de Webhooks.
# El token sin la clave no arranca: Mercado Pago cobraría y nada se activaría.
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=<APP_USR-... de la cuenta de AdoptaFácil>
MERCADOPAGO_WEBHOOK_SECRET=<clave secreta de webhooks de Suscripciones>
# Encender el cobro de planes. Con la fecha de lanzamiento, toda organización
# sin pago tiene Pro gratis 3 meses desde ese día.
PLAN_ENFORCEMENT=true
PLAN_LAUNCH_DATE=<AAAA-MM-DD: el día que abres al público>
# Café: dominio que se imprime en el QR. Debe ser tu APP_DOMAIN.
COFFEE_QR_DOMAINS=adoptafacil.org

# --- Dominio propio del portal (plan Pro) --------------------------------------
# Va junto con CUSTOM_DOMAINS=cloudflare en deploy/.env (Cloudflare for SaaS,
# compatible con el origen cerrado). docs/operacion/DOMINIO-PROPIO.md
CUSTOM_DOMAIN_CNAME_TARGET=portales.adoptafacil.org
# Cloudflare → adoptafacil.org → Overview → API → Zone ID.
CLOUDFLARE_SAAS_ZONE_ID=<Zone ID de adoptafacil.org>
# Token con solo Zone → SSL and Certificates → Edit sobre adoptafacil.org.
CLOUDFLARE_SAAS_API_TOKEN=<token de Cloudflare for SaaS>
# CUSTOM_DOMAIN_IPV4 solo sirve con CUSTOM_DOMAINS=on (sin Cloudflare); con SaaS se ignora.

# --- Firmas en los informes contables ("Listo para firmar", Crece/Pro) ----------
REPORTS_SIGNATURES_ENABLED=true

# --- Opcionales: déjalos con # si no los usas ----------------------------------
# Avisos push en el navegador. Genera el par una vez:
#   pnpm --filter @adoptafacil/api exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=<Public Key>
# VAPID_PRIVATE_KEY=<Private Key>
# VAPID_SUBJECT=mailto:adoptafacil.oficial@gmail.com
#
# Iniciar sesión con Google (además: VITE_GOOGLE_CLIENT_ID en deploy/.env).
# AUTH_IDENTITY_DRIVER=google
# GOOGLE_OAUTH_CLIENT_ID=<Client ID de Google Cloud>.apps.googleusercontent.com
#
# Fotos públicas por la CDN de Cloudflare (docs/operacion/ESCALA.md).
# STORAGE_PUBLIC_CDN_BASE_URL=https://img.adoptafacil.org/api
#
# Métricas para Grafana/Prometheus (openssl rand -hex 24).
# METRICS_TOKEN=<token largo>
#
# Módulos que siguen APAGADOS a propósito (no los enciendas hoy):
# FEATURE_SPONSORSHIPS        aún no cobra con la cuenta de cada refugio (no arranca)
# FEATURE_DONATION_CERTIFICATES  certificado tributario: requiere contador/abogado
# FEATURE_VOLUNTEERING_MINORS  prohibido en producción (no arranca)
# FEATURE_COMMUNITY, FEATURE_COMMUNITY_WALL, FEATURE_REPUTATION, FEATURE_RESOURCES,
# FEATURE_MARKETPLACE          fases posteriores; enciéndelos solo si los vas a moderar
